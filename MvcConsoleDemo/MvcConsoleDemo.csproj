<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TqkLibrary.Automation.Images\TqkLibrary.Automation.Images.csproj" />
  </ItemGroup>

  <!-- Reuse the sample images from ConsoleTest without copying the binaries into the repo twice. -->
  <ItemGroup>
    <None Include="..\ConsoleTest\Resources\baseImage.png" Link="Resources\baseImage.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\ConsoleTest\Resources\searchImage.png" Link="Resources\searchImage.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
